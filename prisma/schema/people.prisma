model FacultyProfile {
  id       String @id @default(uuid()) @db.Uuid
  personId String @unique @map("person_id") @db.Uuid

  academicRank      String? @map("academic_rank") @db.VarChar(150)
  educationSummary  String?
  researchInterests String? @map("research_interests")
  profileUrl        String? @map("profile_url") @db.VarChar(500)

  status ContentStatus @default(draft)

  person Person @relation(fields: [personId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("faculty_profiles")
  @@schema("content")
}
